# Copy this file to .env and fill in real values. Never commit .env.

# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-flash-lite-latest
CORS_ORIGINS=http://localhost:3000

# Contact form (POST /api/contact) — relays submissions over SMTP to
# CONTACT_EMAIL. Works with any SMTP provider; for Gmail, SMTP_USER is your
# address and SMTP_PASSWORD is an App Password (not your normal password) —
# https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=
