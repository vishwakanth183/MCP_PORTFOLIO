# Copy this file to .env and fill in real values. Never commit .env.

# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-flash-lite-latest
CORS_ORIGINS=http://localhost:3000

# Contact form (POST /api/contact) — relays submissions over SMTP to
# CONTACT_EMAIL. Works with any SMTP provider; for Gmail, SMTP_USER is your
# address and SMTP_PASSWORD is an App Password (not your normal password) —
# https://myaccount.google.com/apppasswords
#
# Many free-tier hosts (Render included) block outbound SMTP ports, which
# shows up as this endpoint timing out (~15s) then 502ing even with correct
# credentials. Port 465 (implicit TLS) sometimes gets through when 587
# (STARTTLS) is blocked, or vice versa — try switching this if one hangs.
# If both are blocked, SMTP won't work on that host at all; switch to an
# HTTP-based email API (e.g. Resend) instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
CONTACT_EMAIL=
