# Copy this file to .env and fill in real values. Never commit .env.

# Google AI Studio API key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-flash-lite-latest
CORS_ORIGINS=http://localhost:3000

# Contact form (POST /api/contact) — relays submissions to CONTACT_EMAIL via
# Resend's HTTP API (https://resend.com, free tier: 3,000 emails/month, no
# card required). Sign up, verify the email you want to send FROM (or just
# use their onboarding@resend.dev sandbox sender, which needs no
# verification but can usually only deliver to your own Resend account
# email), then create an API key at https://resend.com/api-keys.
#
# We use an HTTP API instead of raw SMTP because many free-tier hosts
# (Render included) block outbound SMTP ports entirely — confirmed here via
# a 15s connection timeout on port 587 and "Network is unreachable" on 465,
# on every resolved address, which is the network refusing the connection
# outright rather than a wrong password. Regular HTTPS (what Resend uses)
# isn't affected by that block.
RESEND_API_KEY=
CONTACT_EMAIL=
# Optional: only change this once you've verified a custom domain in Resend
# RESEND_FROM=PortfolioMCP Contact <contact@yourdomain.com>
